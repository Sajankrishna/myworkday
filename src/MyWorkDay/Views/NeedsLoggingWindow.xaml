<Window x:Class="MyWorkDay.Views.NeedsLoggingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Needs time logged" Width="480" Height="520" MinWidth="360" MinHeight="300"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PageBg}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ListHost">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource OrangeWash}" CornerRadius="10" Padding="10,10" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Key}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource Blue}"
                                                   Cursor="Hand" TextDecorations="Underline" Tag="{Binding JiraUrl}" MouseLeftButtonUp="TicketKey_Click"/>
                                        <Border Style="{StaticResource StatusPill}" Margin="8,0,0,0" Visibility="{Binding Status, Converter={StaticResource NullToVis}}">
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource StatusPillText}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right" FontSize="11.5" FontWeight="SemiBold" Foreground="#9A3412"
                                               Visibility="{Binding ExpectedMinutes, Converter={StaticResource NullToVis}}"
                                               ToolTip="Jira's Original Estimate for this ticket">
                                        <Run Text="Expected: "/>
                                        <Run Text="{Binding ExpectedMinutes, Converter={StaticResource MinutesLabel}, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                                <TextBlock Text="{Binding Summary}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Button Grid.Row="1" Style="{StaticResource ActionButton}" Content="Close" Click="Close_Click" HorizontalAlignment="Right" Margin="0,10,0,0"/>
    </Grid>
</Window>
