<Window x:Class="MyWorkDay.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MyWorkDay.ViewModels"
        xmlns:controls="clr-namespace:MyWorkDay.Controls"
        Title="MyWorkDay" Height="880" Width="1180" MinHeight="600" MinWidth="820"
        Background="{StaticResource PageBg}"
        FontFamily="Segoe UI" FontSize="13.5"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,28">
            <StackPanel MaxWidth="1400">

                <!-- Top bar -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconBrand}" Stroke="{StaticResource Blue}"
                              StrokeThickness="1.6" Width="22" Height="22" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="MyWorkDay" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                            <TextBlock Text="Track &#8226; Focus &#8226; Deliver" Style="{StaticResource MutedText}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource GreenWash}" CornerRadius="999" Padding="10,4" Margin="0,0,10,0"
                                Visibility="{Binding BreakStatusVisible, Converter={StaticResource BoolToVis}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BreakStatusDue}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource OrangeWash}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding BreakStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Green}"/>
                        </Border>
                        <TextBlock Text="{Binding SyncedAt}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button x:Name="RefreshButton" Command="{Binding RefreshCommand}"
                                ToolTip="Rescan" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconRefresh}" Stroke="{StaticResource Ink}" Width="16" Height="16"/>
                            <Button.RenderTransform>
                                <RotateTransform x:Name="RefreshRotate" Angle="0"/>
                            </Button.RenderTransform>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="SpinStoryboard">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                          From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="SpinStoryboard"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="OpenTicketSearch_Click" ToolTip="Find a ticket (Ctrl+K)" Margin="0,0,8,0">
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconSearch}" Stroke="{StaticResource Ink}" Width="16" Height="16"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="OpenSettings_Click" ToolTip="Settings">
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconSettings}" Stroke="{StaticResource Ink}" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Greeting -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#EAF1FD" Offset="0"/>
                            <GradientStop Color="#F4EEFC" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource Blue}" Margin="0,0,16,0">
                            <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Greeting}" FontSize="12.5" Foreground="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding AuthorName}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                            <TextBlock FontSize="12" FontStyle="Italic" Foreground="{StaticResource Muted}" Margin="0,3,0,0">
                                <Run Text="&#8220;"/>
                                <Run Text="{Binding DailyQuote}"/>
                                <Run Text="&#8221;"/>
                            </TextBlock>
                        </StackPanel>
                        <Border Background="White" CornerRadius="10" Padding="14,8" Margin="24,0,0,0" VerticalAlignment="Center"
                                BorderBrush="#DCE6F7" BorderThickness="1"
                                Visibility="{Binding CalendarSummary, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding CalendarSummary}" FontSize="11.5" FontWeight="SemiBold" Foreground="#1E3A8A"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Stat row -->
                <UniformGrid Columns="4" Margin="0,0,0,14">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource GreenWash}" Margin="0,0,10,0">
                                <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconClock}" Stroke="{StaticResource Green}"
                                      Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding StatLogged}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                                <TextBlock Text="Logged to Jira (selected day)" Style="{StaticResource MutedText}"/>
                                <TextBlock Text="{Binding StatTargetLabel}" Style="{StaticResource MutedText}" FontSize="10.5"/>
                                <ProgressBar Value="{Binding StatTargetPct, Mode=OneWay}" Maximum="100" Height="5" Margin="0,4,0,0"
                                             Background="{StaticResource Line}" Foreground="{StaticResource Green}" BorderThickness="0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="6,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource BlueWash}" Margin="0,0,10,0">
                                <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconDocument}" Stroke="{StaticResource Blue}"
                                      Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding StatTicketsTouched}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                                <TextBlock Text="Tickets touched today" Style="{StaticResource MutedText}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="6,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource PurpleWash}" Margin="0,0,10,0">
                                <Path Data="{StaticResource IconBolt}" Fill="{StaticResource Purple}" Stretch="Uniform"
                                      Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding StatCommentsMade}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                                <TextBlock Text="Comments written today" Style="{StaticResource MutedText}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource OrangeWash}" Margin="0,0,10,0">
                                <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconDocument}" Stroke="{StaticResource Orange}"
                                      Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding StatOpenAssigned}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                                <TextBlock Text="Open tickets assigned to you" Style="{StaticResource MutedText}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Main grid -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left column -->
                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconCalendar}" Stroke="{StaticResource Ink}" Width="15" Height="15" Margin="0,0,6,0"/>
                                        <TextBlock Text="My Work" Style="{StaticResource CardHeaderText}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <DatePicker x:Name="DateJumpPicker" Width="132" Margin="0,0,8,0" ToolTip="Jump to any date"
                                                    SelectedDateChanged="DateJumpPicker_SelectedDateChanged"/>
                                        <ComboBox x:Name="DateSelectCombo" Width="170"
                                                  ItemsSource="{Binding Dates}" SelectedItem="{Binding SelectedDate, Mode=OneWay}"
                                                  SelectionChanged="DateSelect_SelectionChanged">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource DateKeyToLabel}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Style="{StaticResource PrimaryButton}" Click="LogTime_Click" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconPlus}" Stroke="White" Width="11" Height="11" Margin="0,0,5,0"/>
                                            <TextBlock Text="Log Time" Foreground="White"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Content="&#128279; Select from Jira" Click="OpenJira_Click" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource ActionButton}" Background="{StaticResource OrangeWash}" Foreground="#9A3412"
                                            BorderThickness="0" Click="OpenNeedsLogging_Click"
                                            Visibility="{Binding NeedsLogging.Count, Converter={StaticResource ZeroToVis}}">
                                        <TextBlock Text="{Binding NeedsLogging.Count, Converter={StaticResource NeedsLoggingCountToLabel}}"/>
                                    </Button>
                                </StackPanel>
                                <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Tickets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TicketRowViewModel}">
                                            <StackPanel Margin="0,0,0,2">
                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,9">
                                                    <StackPanel>
                                                                        <Grid Cursor="Hand" MouseLeftButtonUp="TicketRow_Toggle">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="30"/>
                                                                <ColumnDefinition Width="66"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="78"/>
                                                                <ColumnDefinition Width="24"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Width="26" Height="26" CornerRadius="8" HorizontalAlignment="Left"
                                                                    Background="{Binding StatusCategory, Converter={StaticResource StatusCategoryToIconBackground}}">
                                                                <Path Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <Path.Style>
                                                                        <Style TargetType="Path">
                                                                            <Setter Property="Data" Value="{StaticResource IconBolt}"/>
                                                                            <Setter Property="Fill" Value="{Binding StatusCategory, Converter={StaticResource StatusCategoryToIconForeground}}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding StatusCategory}" Value="done">
                                                                                    <Setter Property="Data" Value="{StaticResource IconCheckmark}"/>
                                                                                    <Setter Property="Fill" Value="{x:Null}"/>
                                                                                    <Setter Property="Stroke" Value="{Binding StatusCategory, Converter={StaticResource StatusCategoryToIconForeground}}"/>
                                                                                    <Setter Property="StrokeThickness" Value="2.2"/>
                                                                                    <Setter Property="StrokeStartLineCap" Value="Round"/>
                                                                                    <Setter Property="StrokeEndLineCap" Value="Round"/>
                                                                                    <Setter Property="StrokeLineJoin" Value="Round"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Path.Style>
                                                                </Path>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding Key}" FontFamily="Consolas" FontWeight="Bold"
                                                                       FontSize="12" Foreground="{StaticResource Blue}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" Margin="8,0" VerticalAlignment="Center"/>
                                                            <Border Grid.Column="3" Style="{StaticResource StatusPill}" Margin="4,0" VerticalAlignment="Center"
                                                                    Visibility="{Binding Status, Converter={StaticResource NullToVis}}">
                                                                <TextBlock Text="{Binding Status}" Style="{StaticResource StatusPillText}"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Logged}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                                                                <TextBlock Text="{Binding ActivityKind}" FontSize="9.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="5" Style="{StaticResource IconButton}" Width="22" Height="22" ToolTip="Log time on this ticket"
                                                                    Click="TicketRowLogTime_Click" Tag="{Binding Key}">
                                                                <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconPlus}" Stroke="{StaticResource Blue}" Width="10" Height="10"/>
                                                            </Button>
                                                        </Grid>
                                                        <StackPanel Margin="0,6,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                            <ItemsControl ItemsSource="{Binding Actions}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,2">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="60"/>
                                                                                <ColumnDefinition Width="90"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="{Binding TimeLabel}" FontSize="11" Foreground="{StaticResource Muted}"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding KindLabel}" FontSize="11" FontWeight="SemiBold"/>
                                                                            <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Text="Assigned to you - no worklog or comment logged yet today." FontSize="11" Foreground="{StaticResource Muted}" FontStyle="Italic"
                                                                       Visibility="{Binding Actions.Count, Converter={StaticResource ZeroToVis}, ConverterParameter=Invert}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>
                                <TextBlock Text="No tickets recorded for this day." Style="{StaticResource MutedText}" Margin="0,8,0,0"
                                           Visibility="{Binding Tickets.Count, Converter={StaticResource ZeroToVis}, ConverterParameter=Invert}"/>
                                <TextBlock Text="View all work &#8594;" Foreground="{StaticResource Blue}" FontSize="11.5"
                                           HorizontalAlignment="Right" Margin="0,8,0,0" Cursor="Hand" MouseLeftButtonUp="ShowWeek_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconActivity}" Stroke="{StaticResource Ink}" Width="15" Height="15" Margin="0,0,6,0"/>
                                    <TextBlock Text="Recent Activity" Style="{StaticResource CardHeaderText}"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Activity}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56"/>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Time}" FontSize="10.5" Foreground="{StaticResource Muted}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                                <Ellipse Grid.Column="1" Width="7" Height="7" VerticalAlignment="Top" Margin="0,4,0,0"
                                                         Fill="{Binding KindKey, Converter={StaticResource ActivityKindToBrush}}"/>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock FontSize="12">
                                                        <Run Text="{Binding Kind, Mode=OneWay}" FontWeight="Bold"/>
                                                        <Run Text=" on "/>
                                                        <Run Text="{Binding Ticket, Mode=OneWay}" Foreground="{StaticResource Blue}" FontWeight="Bold"/>
                                                        <Run Text=" "/>
                                                        <Run Text="{Binding MinutesLabel, Mode=OneWay}" Foreground="{StaticResource Muted}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No activity recorded for this day." Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                           Visibility="{Binding Activity.Count, Converter={StaticResource ZeroToVis}, ConverterParameter=Invert}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right column -->
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconPieChart}" Stroke="{StaticResource Ink}" Width="15" Height="15" Margin="0,0,6,0"/>
                                    <TextBlock Text="Time Breakdown" Style="{StaticResource CardHeaderText}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <controls:DonutChart Slices="{Binding Donut}" TotalMinutes="{Binding StatLoggedMinutes}" Margin="0,0,16,0"/>
                                    <ItemsControl ItemsSource="{Binding Donut}" AlternationCount="8" VerticalAlignment="Center">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Top" Margin="0,3,8,0"
                                                             Fill="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource IndexToPaletteBrush}}"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="12.5"/>
                                                        <TextBlock FontSize="11" Foreground="{StaticResource Muted}">
                                                            <Run Text="{Binding Minutes, Mode=OneWay, StringFormat={}{0}m}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center">
                                                        <Run Text="{Binding Pct, Mode=OneWay}"/>
                                                        <Run Text="%"/>
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <TextBlock Text="Nothing logged yet for this day." Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                           Visibility="{Binding Donut.Count, Converter={StaticResource ZeroToVis}, ConverterParameter=Invert}"/>
                                <Border Background="{StaticResource BlueWash}" CornerRadius="8" Padding="10,8" Margin="0,10,0,0">
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" FontStyle="Italic" Foreground="#1E40AF">
                                        <Run Text="&#128161; "/>
                                        <Run Text="{Binding DailyQuote}"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14"
                                Visibility="{Binding CalendarEvents.Count, Converter={StaticResource ZeroToVis}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconCalendar}" Stroke="{StaticResource Ink}" Width="15" Height="15" Margin="0,0,6,0"/>
                                        <TextBlock Text="Today's Agenda" Style="{StaticResource CardHeaderText}"/>
                                    </StackPanel>
                                    <Border Background="{StaticResource BlueWash}" CornerRadius="999" Padding="10,3" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding CalendarEvents.Count, StringFormat='{}{0} events'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Blue}"/>
                                    </Border>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding CalendarEvents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,10">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPast}" Value="True">
                                                                <Setter Property="Opacity" Value="0.45"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="{Binding Time}" FontSize="11" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold"/>
                                                <TextBlock FontSize="11" Foreground="{StaticResource Muted}">
                                                    <Run Text="{Binding Duration, Mode=OneWay}"/>
                                                    <Run Text=" "/>
                                                    <Run Text="{Binding Source, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Path Data="{StaticResource IconLightningFilled}" Fill="{StaticResource Ink}" Stretch="Uniform" Width="15" Height="15" Margin="0,0,6,0"/>
                                    <TextBlock Text="Quick Actions" Style="{StaticResource CardHeaderText}"/>
                                </StackPanel>
                                <UniformGrid Columns="2" Rows="2">
                                    <Border Background="{StaticResource GreenWash}" CornerRadius="10" Padding="10,10" Margin="0,0,5,5" Cursor="Hand" MouseLeftButtonUp="Refresh_Tile_Click">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconRefresh}" Stroke="{StaticResource Ink}" Width="14" Height="14" Margin="0,0,6,0"/>
                                                <TextBlock Text="Rescan Now" FontWeight="SemiBold" FontSize="12.5"/>
                                            </StackPanel>
                                            <TextBlock Text="Re-fetch from Jira" Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource BlueWash}" CornerRadius="10" Padding="10,10" Margin="5,0,0,5" Cursor="Hand" MouseLeftButtonUp="OpenJira_Click">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconExternalLink}" Stroke="{StaticResource Ink}" Width="14" Height="14" Margin="0,0,6,0"/>
                                                <TextBlock Text="Open Jira" FontWeight="SemiBold" FontSize="12.5"/>
                                            </StackPanel>
                                            <TextBlock Text="In your browser" Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource PurpleWash}" CornerRadius="10" Padding="10,10" Margin="0,5,5,0" Cursor="Hand" MouseLeftButtonUp="TimeHistory_Click">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconClock}" Stroke="{StaticResource Ink}" Width="14" Height="14" Margin="0,0,6,0"/>
                                                <TextBlock Text="Time History" FontWeight="SemiBold" FontSize="12.5"/>
                                            </StackPanel>
                                            <TextBlock Text="Browse past days" Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource OrangeWash}" CornerRadius="10" Padding="10,10" Margin="5,5,0,0" Cursor="Hand" MouseLeftButtonUp="OpenSettings_Click">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconSettings}" Stroke="{StaticResource Ink}" Width="14" Height="14" Margin="0,0,6,0"/>
                                                <TextBlock Text="Settings" FontWeight="SemiBold" FontSize="12.5"/>
                                            </StackPanel>
                                            <TextBlock Text="Jira &amp; scan config" Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                                <Border Background="{StaticResource BlueWash}" CornerRadius="10" Padding="14,12" Margin="0,10,0,0" Cursor="Hand" MouseLeftButtonUp="ShowWeek_Click">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconBarChart}" Stroke="#1E3A8A" Width="14" Height="14" Margin="0,0,8,0"/>
                                            <StackPanel>
                                                <TextBlock Text="Weekly Summary" FontWeight="SemiBold" FontSize="12.5" Foreground="#1E3A8A"/>
                                                <TextBlock Text="View your last 7 days total" Style="{StaticResource MutedText}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconChevronRight}" Stroke="{StaticResource Blue}"
                                              Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border Background="{StaticResource BlueWash}" CornerRadius="10" Padding="14,12" Margin="0,8,0,0" Cursor="Hand" MouseLeftButtonUp="OpenTeamWindow_Click">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconPeople}" Stroke="#1E3A8A" Width="14" Height="14" Margin="0,0,8,0"/>
                                            <StackPanel>
                                                <TextBlock Text="Team Worklogs" FontWeight="SemiBold" FontSize="12.5" Foreground="#1E3A8A"/>
                                                <TextBlock Text="Search &amp; track teammates' logged time" Style="{StaticResource MutedText}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconChevronRight}" Stroke="{StaticResource Blue}"
                                              Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Team Worklog summary - only shown once a roster exists (see
                             TeamWorklogViewModel.CheckRoster, a cheap local-config check, no
                             network), same as the Python build's checkTeamRoster(). -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0"
                                DataContext="{Binding TeamVm}"
                                Visibility="{Binding HasRoster, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconPeople}" Stroke="{StaticResource Ink}" Width="15" Height="15" Margin="0,0,6,0"/>
                                        <TextBlock Text="Team Worklog" Style="{StaticResource CardHeaderText}"/>
                                    </StackPanel>
                                    <DatePicker x:Name="TeamDatePicker" HorizontalAlignment="Right" Width="132"
                                                Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}"
                                                SelectedDateChanged="TeamDatePicker_SelectedDateChanged"/>
                                </Grid>

                                <StackPanel HorizontalAlignment="Center" Margin="0,6,0,4"
                                            Visibility="{Binding IsLoaded, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="See what your team logged, ticket by ticket." Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <Button Style="{StaticResource GhostButton}" Content="Load team worklog" Command="{Binding LoadCommand}" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Members}" Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,10">
                                                <Grid Cursor="Hand" MouseLeftButtonUp="TeamMemberRow_Toggle">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource PurpleWash}">
                                                        <TextBlock Text="{Binding Initials}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Purple}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding TotalLabel}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource Blue}" VerticalAlignment="Center"/>
                                                </Grid>
                                                <ProgressBar Value="{Binding StrengthPct, Mode=OneWay}" Maximum="100" Height="5" Margin="32,5,0,0"
                                                             Background="{StaticResource Line}" BorderThickness="0"
                                                             Foreground="{Binding StrengthPct, Converter={StaticResource StrengthPctToBrush}}"/>
                                                <ItemsControl ItemsSource="{Binding Tickets}" Margin="32,6,0,0"
                                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="66"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Key}" FontWeight="SemiBold" Foreground="{StaticResource Blue}" FontSize="11"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="4,0"/>
                                                                <TextBlock Grid.Column="2" FontWeight="SemiBold" FontSize="11">
                                                                    <Run Text="{Binding Minutes, Mode=OneWay}"/>
                                                                    <Run Text="m"/>
                                                                </TextBlock>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Open full Team Worklogs window &#8594;" Foreground="{StaticResource Blue}" FontSize="11.5"
                                           HorizontalAlignment="Right" Margin="0,4,0,0" Cursor="Hand" MouseLeftButtonUp="OpenTeamWindow_Click"
                                           Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <TextBlock Text="MyWorkDay &#183; Jira-only, no local git scanning" Style="{StaticResource MutedText}" Margin="0,14,0,0" HorizontalAlignment="Right"/>
            </StackPanel>
        </ScrollViewer>

        <Border Background="#CCEEF3FB" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Refreshing from Jira&#8230;" FontSize="13" Foreground="{StaticResource Muted}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
