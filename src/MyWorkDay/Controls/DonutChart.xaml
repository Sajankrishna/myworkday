<UserControl x:Class="MyWorkDay.Controls.DonutChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="132" Height="132">
    <Grid x:Name="RootGrid">
        <Canvas x:Name="SliceCanvas" Width="132" Height="132"/>
        <Border Width="76" Height="76" CornerRadius="38" Background="{StaticResource CardBg}"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="TotalText" Text="0m" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource Ink}"/>
                <TextBlock Text="Total" FontSize="9.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
