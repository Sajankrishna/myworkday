<Application x:Class="MyWorkDay.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MyWorkDay"
             xmlns:conv="clr-namespace:MyWorkDay.Converters">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Palette ported from the original app's CSS custom properties -->
            <SolidColorBrush x:Key="Ink" Color="#1C2430"/>
            <SolidColorBrush x:Key="Muted" Color="#6B7280"/>
            <SolidColorBrush x:Key="Line" Color="#E5E7EB"/>
            <SolidColorBrush x:Key="PageBg" Color="#EEF3FB"/>
            <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="Blue" Color="#2563EB"/>
            <SolidColorBrush x:Key="BlueWash" Color="#DBEAFE"/>
            <SolidColorBrush x:Key="Green" Color="#16A34A"/>
            <SolidColorBrush x:Key="GreenWash" Color="#DCFCE7"/>
            <SolidColorBrush x:Key="Purple" Color="#7C3AED"/>
            <SolidColorBrush x:Key="PurpleWash" Color="#EDE9FE"/>
            <SolidColorBrush x:Key="Orange" Color="#EA580C"/>
            <SolidColorBrush x:Key="OrangeWash" Color="#FFEDD5"/>
            <SolidColorBrush x:Key="Red" Color="#DC2626"/>
            <SolidColorBrush x:Key="RedWash" Color="#FEE2E2"/>

            <!-- ============================================================
                 Icons - exact geometry ported from the Python build's inline
                 SVGs (same viewBox="0 0 24 24" coordinate space, same line
                 shapes/circles/polylines), just expressed as WPF Path mini-
                 language data instead of SVG markup. Stroke/Fill/size are
                 set per usage site to match each SVG's own attributes. ============================================================ -->
            <PathGeometry x:Key="IconBrand" Figures="M20,4 L6,18 M6,18 L4,21 M16,8 L11,8 M13,11 L9,11 M10,14 L7,14"/>
            <PathGeometry x:Key="IconRefresh" Figures="M21,12 A9,9 0 1 1 18,5.3 M21,3 L21,9 L15,9"/>
            <PathGeometry x:Key="IconSettings" Figures="M9,12 A3,3 0 1 0 15,12 A3,3 0 1 0 9,12 M12,2 L12,5 M12,19 L12,22 M2,12 L5,12 M19,12 L22,12 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M4.9,19.1 L7,17 M17,7 L19.1,4.9"/>
            <PathGeometry x:Key="IconClock" Figures="M3,12 A9,9 0 1 0 21,12 A9,9 0 1 0 3,12 M12,7 L12,12 L15.5,14"/>
            <PathGeometry x:Key="IconDocument" Figures="M7,3 L17,3 A2,2 0 0 1 19,5 L19,19 A2,2 0 0 1 17,21 L7,21 A2,2 0 0 1 5,19 L5,5 A2,2 0 0 1 7,3 Z M8,8 L16,8 M8,12 L16,12 M8,16 L13,16"/>
            <PathGeometry x:Key="IconBolt" Figures="M13,2 L3,14 L10,14 L9,22 L19,10 L12,10 Z"/>
            <PathGeometry x:Key="IconRepos" Figures="M5,5 A7,2.5 0 1 0 19,5 A7,2.5 0 1 0 5,5 M5,5 L5,19 A7,2.5 0 0 0 19,19 L19,5 M5,12 A7,2.5 0 0 0 19,12"/>
            <PathGeometry x:Key="IconCalendar" Figures="M5,4 L19,4 A2,2 0 0 1 21,6 L21,20 A2,2 0 0 1 19,22 L5,22 A2,2 0 0 1 3,20 L3,6 A2,2 0 0 1 5,4 Z M16,2 L16,6 M8,2 L8,6 M3,10 L21,10"/>
            <PathGeometry x:Key="IconActivity" Figures="M3,12 L8,12 L10,6 L14,18 L16,12 L21,12"/>
            <PathGeometry x:Key="IconPieChart" Figures="M3,12 A9,9 0 1 0 21,12 A9,9 0 1 0 3,12 M12,12 L12,3 M12,12 L18.5,16"/>
            <PathGeometry x:Key="IconLightningFilled" Figures="M13,2 L3,14 L11,14 L9,22 L21,10 L13,10 Z"/>
            <PathGeometry x:Key="IconPeople" Figures="M17,21 v-2 a4,4 0 0 0 -4,-4 H5 a4,4 0 0 0 -4,4 v2 M5,7 A4,4 0 1 0 13,7 A4,4 0 1 0 5,7 M23,21 v-2 a4,4 0 0 0 -3,-3.87 M16,3.13 a4,4 0 0 1 0,7.75"/>
            <PathGeometry x:Key="IconChevronRight" Figures="M9,18 L15,12 L9,6"/>
            <PathGeometry x:Key="IconExternalLink" Figures="M18,13 v6 a2,2 0 0 1 -2,2 H5 a2,2 0 0 1 -2,-2 V8 a2,2 0 0 1 2,-2 H11 M15,3 L21,3 L21,9 M10,14 L21,3"/>
            <PathGeometry x:Key="IconBarChart" Figures="M12,20 L12,10 M18,20 L18,4 M6,20 L6,16"/>
            <PathGeometry x:Key="IconCheckmark" Figures="M20,6 L9,17 L4,12"/>

            <Style x:Key="LineIcon" TargetType="Path">
                <Setter Property="StrokeThickness" Value="2"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/>
                <Setter Property="StrokeEndLineCap" Value="Round"/>
                <Setter Property="StrokeLineJoin" Value="Round"/>
                <Setter Property="Stretch" Value="Uniform"/>
            </Style>

            <conv:StatusCategoryToBrushConverter x:Key="StatusCategoryToBrush"/>
            <conv:StatusCategoryToForegroundConverter x:Key="StatusCategoryToForeground"/>
            <conv:StatusCategoryToIconBackgroundConverter x:Key="StatusCategoryToIconBackground"/>
            <conv:StatusCategoryToIconForegroundConverter x:Key="StatusCategoryToIconForeground"/>
            <conv:StatusCategoryToIconGlyphConverter x:Key="StatusCategoryToIconGlyph"/>
            <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
            <conv:NullToVisibilityConverter x:Key="NullToVis"/>
            <conv:ZeroToVisibilityConverter x:Key="ZeroToVis"/>
            <conv:DateKeyToLabelConverter x:Key="DateKeyToLabel"/>
            <conv:ActivityKindToBrushConverter x:Key="ActivityKindToBrush"/>
            <conv:StrengthPctToBrushConverter x:Key="StrengthPctToBrush"/>
            <conv:IndexToPaletteBrushConverter x:Key="IndexToPaletteBrush"/>
            <conv:NeedsLoggingCountToLabelConverter x:Key="NeedsLoggingCountToLabel"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBg}"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="14" ShadowDepth="2" Direction="270"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CardHeaderText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            </Style>

            <Style x:Key="MutedText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            </Style>

            <!-- Just colored text, no badge/chip background - the wrapping Border is kept as a
                 no-op (transparent, no padding) so every existing "Style=StatusPill" usage site
                 doesn't need its own XAML edit. -->
            <Style x:Key="StatusPill" TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
            </Style>

            <Style x:Key="StatusPillText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{Binding StatusCategory, Converter={StaticResource StatusCategoryToForeground}}"/>
            </Style>

            <Style x:Key="ActionButton" TargetType="Button">
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
                <Setter Property="Background" Value="{StaticResource Blue}"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>

            <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
                <Setter Property="Background" Value="{StaticResource BlueWash}"/>
                <Setter Property="Foreground" Value="{StaticResource Blue}"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>

            <!-- Round icon-only button, matching the top bar's rescan/settings buttons in the
                 Python build (a plain white circle with a centered glyph, no visible border). -->
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Background" Value="{StaticResource CardBg}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="12">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="8" ShadowDepth="1" Direction="270"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Shell" Property="Background" Value="#F9FAFB"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============================================================
                 Dropdown (ComboBox) styling, ported from Ezee.Church's
                 FormComboBox: a rounded, outlined "card-style" field - white
                 fill, thin gray border, 6px corners, an emerald-green focus
                 ring, and a blue-accented selected/hovered dropdown item.
                 Ezee builds this as a bordered shell wrapped around a
                 borderless HandyControl ComboBox; this app has no
                 HandyControl dependency, so the same look is reproduced
                 directly as a native ComboBox ControlTemplate instead -
                 same colors, same shape, applied to every ComboBox in the
                 app (implicit style, no x:Key). ============================================================ -->
            <SolidColorBrush x:Key="EzeeBorder" Color="#D1D5DB"/>
            <SolidColorBrush x:Key="EzeeFocusBorder" Color="#10B981"/>
            <SolidColorBrush x:Key="EzeeSelectedBg" Color="#3B82F6"/>
            <SolidColorBrush x:Key="EzeeSelectedHoverBg" Color="#2563EB"/>
            <SolidColorBrush x:Key="EzeeHoverBg" Color="#F3F4F6"/>
            <SolidColorBrush x:Key="EzeeTextPrimary" Color="#111827"/>
            <SolidColorBrush x:Key="EzeePlaceholder" Color="#9CA3AF"/>

            <Style TargetType="ComboBoxItem">
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="Foreground" Value="{StaticResource EzeeTextPrimary}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="ItemBorder" CornerRadius="6" Margin="4,2" Padding="{TemplateBinding Padding}"
                                    Background="Transparent">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource EzeeHoverBg}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource EzeeSelectedBg}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="True"/>
                                        <Condition Property="IsHighlighted" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource EzeeSelectedHoverBg}"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="{StaticResource EzeeTextPrimary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource EzeeBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="Shell" Grid.ColumnSpan="2" CornerRadius="6" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>

                                <ToggleButton x:Name="ToggleButton" Grid.ColumnSpan="2" Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press" Background="Transparent" BorderThickness="0">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <ContentPresenter x:Name="ContentSite" Grid.Column="0" IsHitTestVisible="False"
                                                   Margin="{TemplateBinding Padding}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                                   Content="{TemplateBinding SelectionBoxItem}"
                                                   ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>

                                <Path x:Name="Arrow" Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center"
                                      Data="M0,0 L6,6 L12,0" Stroke="{StaticResource EzeePlaceholder}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"/>

                                <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                    <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320" Margin="0,4,0,0"
                                            Background="White" BorderBrush="{StaticResource EzeeBorder}" BorderThickness="1" CornerRadius="8">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" Opacity="0.12" BlurRadius="16" ShadowDepth="3" Direction="270"/>
                                        </Border.Effect>
                                        <ScrollViewer Padding="2" SnapsToDevicePixels="True">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource EzeeFocusBorder}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Shell" Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============================================================
                 DatePicker styling - same Ezee.Church "card" shell as the
                 ComboBox above (rounded 6px, white fill, gray border, emerald
                 focus ring), plus a matching Calendar popup. Applied as an
                 implicit style so every DatePicker in the app (My Work's date
                 jump, the Team Worklog date pickers) gets it automatically. ============================================================ -->
            <Style TargetType="CalendarDayButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CalendarDayButton">
                            <Border x:Name="DayBorder" CornerRadius="6" Margin="1" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="DayBorder" Property="Background" Value="{StaticResource EzeeHoverBg}"/>
                                </Trigger>
                                <Trigger Property="IsToday" Value="True">
                                    <Setter TargetName="DayBorder" Property="BorderBrush" Value="{StaticResource EzeeFocusBorder}"/>
                                    <Setter TargetName="DayBorder" Property="BorderThickness" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="DayBorder" Property="Background" Value="{StaticResource EzeeSelectedBg}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsBlackedOut" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource EzeePlaceholder}"/>
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="CalendarButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CalendarButton">
                            <Border x:Name="MonthBorder" CornerRadius="6" Margin="1" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="MonthBorder" Property="Background" Value="{StaticResource EzeeHoverBg}"/>
                                </Trigger>
                                <Trigger Property="IsInactive" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource EzeePlaceholder}"/>
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Calendar">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>

            <Style TargetType="DatePickerTextBox">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DatePickerTextBox">
                            <TextBox x:Name="PART_TextBox" Text="{Binding Path=SelectedDate, RelativeSource={RelativeSource AncestorType=DatePicker}, StringFormat='MM/dd/yyyy'}"
                                     Background="Transparent" BorderThickness="0" Padding="10,7" VerticalContentAlignment="Center"
                                     Foreground="{StaticResource EzeeTextPrimary}" FontSize="12.5" IsReadOnly="True" Focusable="True"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="DatePicker">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="{StaticResource EzeeBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{StaticResource EzeeTextPrimary}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DatePicker">
                            <Grid>
                                <Border x:Name="Shell" CornerRadius="6" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"/>
                                        <Button x:Name="PART_Button" Grid.Column="1" Width="28" Focusable="False"
                                                Background="Transparent" Padding="0" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent">
                                                        <TextBlock Text="&#128197;" FontSize="12" Foreground="{StaticResource EzeePlaceholder}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                                <Popup x:Name="PART_Popup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide">
                                    <Border Margin="0,4,0,0" Background="White" BorderBrush="{StaticResource EzeeBorder}" BorderThickness="1" CornerRadius="8" Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" Opacity="0.12" BlurRadius="16" ShadowDepth="3" Direction="270"/>
                                        </Border.Effect>
                                        <Calendar x:Name="PART_Calendar"/>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource EzeeFocusBorder}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Shell" Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
